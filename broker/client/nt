#!/usr/bin/env python3
"""`nt` — Notion commands (container side). Same commands as before; reads are filtered by the privacy broker
on the laptop, writes pass straight through (with undo). Private values show as placeholders like [ACCOUNT_1];
keep them exactly as written in edits (lines with hidden values are locked) and the laptop fills in the real values.

  nt search "<text>" [--max 10] | nt read <id> [--depth 2] | nt dbs | nt query <db_id> [--max 20]
  nt create --parent <page_or_db_id> --title "…" [--props JSON] [--md "markdown" | --md-file F]
  nt append <page_id> --md "…" --confirmed | nt set <page_id> --props JSON --confirmed
  nt archive <page_id> --confirmed | nt move <page_id> --to <parent_page_id> --confirmed
  nt log [--max 10] | nt undo [<change_id>]
Markdown link lines: [[page:<id>]] or [[db:<id>]].
"""
import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from brokerclient import call, out  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="nt")
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("search"); p.add_argument("text"); p.add_argument("--max", type=int, default=10)
    p = sp.add_parser("read"); p.add_argument("id"); p.add_argument("--depth", type=int, default=2)
    sp.add_parser("dbs")
    p = sp.add_parser("query"); p.add_argument("db_id"); p.add_argument("--max", type=int, default=20)
    p = sp.add_parser("create"); p.add_argument("--parent", required=True); p.add_argument("--title", required=True)
    p.add_argument("--props", default="{}"); p.add_argument("--md", default=""); p.add_argument("--md-file")
    p = sp.add_parser("append"); p.add_argument("page_id"); p.add_argument("--md", default=""); p.add_argument("--md-file")
    p.add_argument("--confirmed", action="store_true")
    p = sp.add_parser("set"); p.add_argument("page_id"); p.add_argument("--props", required=True); p.add_argument("--confirmed", action="store_true")
    p = sp.add_parser("archive"); p.add_argument("page_id"); p.add_argument("--confirmed", action="store_true")
    p = sp.add_parser("move"); p.add_argument("page_id"); p.add_argument("--to", required=True); p.add_argument("--confirmed", action="store_true")
    p = sp.add_parser("log"); p.add_argument("--max", type=int, default=10)
    p = sp.add_parser("undo"); p.add_argument("change_id", nargs="?")
    a = ap.parse_args()
    md = lambda: Path(a.md_file).read_text() if getattr(a, "md_file", None) else a.md  # noqa: E731

    if a.cmd == "search":
        out(call("notion.search", text=a.text, max=a.max))
    elif a.cmd == "read":
        out(call("notion.read", id=a.id, depth=a.depth))
    elif a.cmd == "dbs":
        out(call("notion.dbs"))
    elif a.cmd == "query":
        out(call("notion.query", db_id=a.db_id, max=a.max))
    elif a.cmd == "create":
        out(call("notion.create", parent=a.parent, title=a.title, props=a.props, md=md()))
    elif a.cmd == "append":
        out(call("notion.append", page_id=a.page_id, md=md(), confirmed=a.confirmed))
    elif a.cmd == "set":
        out(call("notion.set", page_id=a.page_id, props=a.props, confirmed=a.confirmed))
    elif a.cmd == "archive":
        out(call("notion.archive", page_id=a.page_id, confirmed=a.confirmed))
    elif a.cmd == "move":
        out(call("notion.move", page_id=a.page_id, to=a.to, confirmed=a.confirmed))
    elif a.cmd == "log":
        out(call("notion.log", max=a.max))
    elif a.cmd == "undo":
        out(call("notion.undo", change_id=a.change_id))


if __name__ == "__main__":
    main()
