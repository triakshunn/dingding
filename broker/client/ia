#!/usr/bin/env python3
"""Email and calendar commands through the laptop's privacy broker.

Only drafts are supported; this client cannot send email. Run `ia --help` or
read the inbox skill for command usage.
"""

import argparse

from brokerclient import call
from brokerclient import out

FLIGHT_WATCH_ARGC = 3


def main():  # noqa: PLR0912, PLR0915  (CLI subcommand dispatcher)
    ap = argparse.ArgumentParser(prog="ia")
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("accounts")
    p = sp.add_parser("brief")
    p.add_argument("--peek", action="store_true")
    p.add_argument("--max", type=int, default=40)
    g = p.add_mutually_exclusive_group()
    for k in ("morning", "midday", "evening"):
        g.add_argument("--" + k, dest="kind", action="store_const", const=k)
    p = sp.add_parser("brief-start")
    p.add_argument("--max", type=int, default=40)
    g = p.add_mutually_exclusive_group()
    for k in ("morning", "midday", "evening"):
        g.add_argument("--" + k, dest="kind", action="store_const", const=k)
    p = sp.add_parser("brief-job")
    p.add_argument("job_id")
    p = sp.add_parser("brief-ack")
    p.add_argument("job_id")
    p = sp.add_parser("new")
    p.add_argument("--peek", action="store_true")
    p.add_argument("--max", type=int, default=40)
    p = sp.add_parser("search")
    p.add_argument("query")
    p.add_argument("--account")
    p.add_argument("--max", type=int, default=5)
    p = sp.add_parser("read")
    p.add_argument("account")
    p.add_argument("id")
    for name in ("suggest-event", "cal-add-new"):
        p = sp.add_parser(name)
        p.add_argument("--title", required=True)
        p.add_argument("--start", required=True)
        p.add_argument("--end")
        p.add_argument("--all-day", action="store_true")
        p.add_argument("--location")
        if name == "suggest-event":
            p.add_argument("--source")
    p = sp.add_parser("suggest-reply")
    p.add_argument("--source", required=True)
    p.add_argument("--why", default="")
    sp.add_parser("pending")
    p = sp.add_parser("dismiss")
    p.add_argument("n", nargs="+", type=int)
    p = sp.add_parser("cal-add")
    p.add_argument("n", nargs="+", type=int)
    p = sp.add_parser("cal-list")
    p.add_argument("--days", type=int, default=7)
    p = sp.add_parser("cal-events")
    p.add_argument("--days", type=int, default=14)
    p = sp.add_parser("cal-edit")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--start")
    p.add_argument("--end")
    p.add_argument("--all-day", action="store_true")
    p.add_argument("--location")
    p = sp.add_parser("cal-undo")
    p.add_argument("change_id", nargs="?")
    p = sp.add_parser("draft")
    p.add_argument("n", type=int)
    p.add_argument("--body", required=True)
    p = sp.add_parser("recent")
    p.add_argument("--bucket")
    p = sp.add_parser("archive")
    p.add_argument("targets", nargs="*")
    p.add_argument("--bucket")
    p.add_argument("--batch", type=int, default=1)
    p.add_argument("--confirmed", action="store_true")
    p.add_argument("--keep-unread", action="store_true")
    p = sp.add_parser("unarchive")
    p.add_argument("batch_id", nargs="?")
    p = sp.add_parser("undo-mail")
    p.add_argument("batch_id", nargs="?")
    p = sp.add_parser("cleanup")
    p.add_argument("--area", action="append", default=[])
    p.add_argument("--older-than", type=int, default=0)
    p.add_argument("--action", default="trash")
    p.add_argument("--account", action="append", default=[])
    p.add_argument("--confirm")
    sp.add_parser("mail-log")
    p = sp.add_parser("track")
    p.add_argument(
        "what",
        nargs="?",
        choices=["bills", "waiting", "flights", "watches", "dismiss"],
    )
    p.add_argument("ids", nargs="*")
    p = sp.add_parser("flight-search")
    p.add_argument(
        "--leg",
        nargs=3,
        action="append",
        required=True,
        metavar=("FROM", "TO", "DATES"),
    )
    p.add_argument("--no-carry-on", action="store_true")
    p = sp.add_parser("flight-watch")
    p.add_argument("action", choices=["add", "list", "rm"])
    p.add_argument("args", nargs="*")
    p.add_argument("--return", dest="ret")
    p.add_argument("--max-price", type=float)
    a = ap.parse_args()

    def ev():
        return {
            "title": a.title,
            "start": a.start,
            "end": a.end,
            "all_day": a.all_day,
            "location": a.location,
        }

    if a.cmd == "accounts":
        out(call("accounts"))
    elif a.cmd == "new":
        out(call("mail.new", peek=a.peek, max=a.max))
    elif a.cmd == "search":
        out(call("mail.search", query=a.query, account=a.account, max=a.max))
    elif a.cmd == "read":
        out(call("mail.read", account=a.account, id=a.id))
    elif a.cmd == "suggest-event":
        out(call("suggest-event", source=a.source, **ev()))
    elif a.cmd == "cal-add-new":
        out(call("cal.add-new", **ev()))
    elif a.cmd == "suggest-reply":
        out(call("suggest-reply", source=a.source, why=a.why))
    elif a.cmd == "pending":
        out(call("pending"))
    elif a.cmd == "dismiss":
        out(call("dismiss", n=a.n))
    elif a.cmd == "cal-add":
        out(call("cal.add", n=a.n))
    elif a.cmd == "cal-list":
        out(call("cal.list", days=a.days))
    elif a.cmd == "draft":
        out(call("draft", n=a.n, body=a.body))
    elif a.cmd == "recent":
        out(call("mail.recent", bucket=a.bucket))
    elif a.cmd == "archive":
        if not a.targets and not a.bucket:
            ap.error("archive: give refs/numbers or --bucket")
        out(
            call(
                "mail.archive",
                targets=a.targets,
                bucket=a.bucket,
                batch=a.batch,
                confirmed=a.confirmed,
                mark_read=not a.keep_unread,
            )
        )
    elif a.cmd == "cleanup":
        if a.confirm:
            out(call("mail.cleanup", confirm=a.confirm))
        else:
            out(
                call(
                    "mail.cleanup",
                    areas=a.area,
                    older_than_days=a.older_than,
                    action=a.action,
                    accounts=a.account or None,
                )
            )
    elif a.cmd == "cal-events":
        out(call("cal.events", days=a.days))
    elif a.cmd == "cal-edit":
        out(
            call(
                "cal.edit",
                id=a.id,
                title=a.title,
                start=a.start,
                end=a.end,
                all_day=a.all_day,
                location=a.location,
            )
        )
    elif a.cmd == "cal-undo":
        out(call("cal.undo", change_id=a.change_id))
    elif a.cmd == "brief":
        out(call("brief", kind=a.kind, peek=a.peek, max=a.max))
    elif a.cmd == "brief-start":
        job = call("brief.start", kind=a.kind, max=a.max)
        out(call("brief.wait", job_id=job["job_id"], seconds=55))
    elif a.cmd == "brief-job":
        out(call("brief.job", job_id=a.job_id, claim=True))
    elif a.cmd == "brief-ack":
        out(call("brief.ack", job_id=a.job_id))
    elif a.cmd == "track":
        if a.what == "dismiss":
            out(call("track.dismiss", ids=a.ids))
        else:
            out(call("track", what=a.what))
    elif a.cmd == "flight-search":
        legs = [
            {"from": f, "to": t, "dates": d.split(",")} for f, t, d in a.leg
        ]
        out(call("flight.search", legs=legs, carry_on=not a.no_carry_on))
    elif a.cmd == "flight-watch":
        if a.action == "add":
            if len(a.args) != FLIGHT_WATCH_ARGC:
                ap.error("flight-watch add FROM TO YYYY-MM-DD")
            out(
                call(
                    "flight-watch.add",
                    **{
                        "from": a.args[0],
                        "to": a.args[1],
                        "depart": a.args[2],
                        "return": a.ret,
                        "max_price": a.max_price,
                    },
                )
            )
        elif a.action == "rm":
            out(call("flight-watch.rm", id=(a.args or [""])[0]))
        else:
            out(call("flight-watch.list"))
    elif a.cmd == "mail-log":
        out(call("mail.log"))
    elif a.cmd in ("unarchive", "undo-mail"):
        out(call("mail.unarchive", batch_id=a.batch_id))


if __name__ == "__main__":
    main()
